# ---------------------------------------------------------------
# Voxify backend settings
# Copy this file to ".env" and change values. NEVER commit ".env".
# ---------------------------------------------------------------

# App
APP_NAME=Voxify
APP_VERSION=1.0.0
APP_ENV=development        # development | production
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# CORS - comma separated list of frontend URLs allowed to call this API
# 5500 = VS Code Live Server, 3000/5173 = other common dev servers
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000,http://localhost:5173

# Upload limits in MB (from project specification)
MAX_VIDEO_MB=50
MAX_AUDIO_MB=25
MAX_PDF_MB=20
MAX_IMAGE_MB=10
MAX_TEXT_FILE_MB=5

# Firebase settings will be added in Step 3
